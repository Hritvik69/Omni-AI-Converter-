# Vercel web
NEXT_PUBLIC_API_URL=https://omniconvert-backend.onrender.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Backend service
NODE_ENV=production
WEB_ORIGIN=https://your-vercel-site.vercel.app
ALLOW_DEMO_AUTH=true
DEMO_SESSION_SECRET=replace-with-a-long-random-secret
RUN_DB_MIGRATIONS=true

# Managed data services. Render Blueprint can create these automatically.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
REDIS_URL=rediss://default:password@host:6379

# Demo storage. Use local for the one-service Render demo.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=/app/storage

# Optional production storage: set STORAGE_DRIVER=s3 and fill these.
AWS_REGION=auto
S3_BUCKET=local
S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://account-id.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=900

# Upload limits for small free/demo hosts
MAX_UPLOAD_BYTES=104857600
UPLOAD_CHUNK_BYTES=4194304
UPLOAD_SESSION_TTL_SECONDS=86400
CLAMAV_REQUIRED=false
CLAMSCAN_BIN=clamscan

# Worker tuning
WORKER_CONCURRENCY=2
WORK_TMP_DIR=./tmp/worker

# Conversion engine binaries
MAGICK_BIN=convert
WKHTMLTOIMAGE_BIN=wkhtmltoimage
PDFINFO_BIN=pdfinfo

# Optional auth and AI providers
CLERK_SECRET_KEY=
CLERK_AUTH_ENABLED=true
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TEXT_MODEL=gpt-4.1-mini
GEMINI_TEXT_MODEL=gemini-2.5-flash
