# Public app
NEXT_PUBLIC_API_URL=http://localhost:4000
# Create an app at https://dashboard.clerk.com and paste your *test* keys here.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# Local development opens the converter without Clerk's browser gate by default.
CLERK_AUTH_ENABLED=false

# Backend
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
ALLOW_DEMO_AUTH=false
DEMO_SESSION_SECRET=
DATABASE_URL=postgresql://omniconvert:omniconvert@localhost:5432/omniconvert
REDIS_URL=redis://localhost:6379
JWT_ISSUER=
CLERK_JWT_TEMPLATE=
STORAGE_DRIVER=s3
LOCAL_STORAGE_DIR=./storage

# S3-compatible storage. Docker compose uses MinIO locally.
AWS_REGION=us-east-1
S3_BUCKET=omniconvert-dev
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
SIGNED_URL_TTL_SECONDS=900

# File safety
MAX_UPLOAD_BYTES=5368709120
UPLOAD_CHUNK_BYTES=8388608
UPLOAD_SESSION_TTL_SECONDS=86400
UPLOAD_TMP_DIR=./uploads
CLAMAV_REQUIRED=false
CLAMSCAN_BIN=clamscan

# Conversion engine binaries
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
MAGICK_BIN=magick
LIBREOFFICE_BIN=soffice
PANDOC_BIN=pandoc
WKHTMLTOPDF_BIN=wkhtmltopdf
WKHTMLTOIMAGE_BIN=wkhtmltoimage
GHOSTSCRIPT_BIN=gs
TESSERACT_BIN=tesseract
PDFTOPPM_BIN=pdftoppm
PDFTOTEXT_BIN=pdftotext
PDFINFO_BIN=pdfinfo
REALESRGAN_BIN=
REMBG_BIN=rembg
REMBG_MODEL=u2netp

# AI providers. At least one provider is required for AI summarization/analyzer.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TEXT_MODEL=gpt-4.1-mini
GEMINI_TEXT_MODEL=gemini-2.5-flash
